{
  "name": "dsh-go-purge",
  "version": "0.6.6",
  "description": "把 dsh-purge 移植适配到 dsh-go（Android + proot）：只保留核心能力——提示词注入和引擎源码补丁，桌面版的 Electron 适配、asar 解包、Windows 计划任务等在手机上没有落点，一并抛弃。它把日常使用里最消耗注意力的几件事收敛到一处：状态一眼看清（点胶囊打开面板，补丁/注入/变体/待办都在一屏）、少一些往返（把反复出现的确认收敛成一次设置）、随时能回去（应用与还原前自动快照，一条命令撤销）、方便做实验（提示词和题材分类集中管理，改坏了能撤）。社区通常把它叫作「破甲」——指的是它降低了交互层面的摩擦。插件已经设计成用户安装可以不依赖任何自动化：App 自带终端，用户手动粘命令即可，步骤见 README 第 2 章。它不改模型权重、不发网络请求、不动你的项目文件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./view": "./lib/view.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./patches/core": "./patches/lib/core.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "AGPL-3.0",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "author": "NANA7MI0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NANA7MI0/dsh-purge-go.git"
  },
  "homepage": "https://github.com/NANA7MI0/dsh-purge-go#readme",
  "bugs": {
    "url": "https://github.com/NANA7MI0/dsh-purge-go/issues"
  },
  "files": [
    "install.sh",
    "lib",
    "patches",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "scripts",
    "assets/categories.json"
  ],
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "破甲",
      "en": "Purge"
    },
    "icon": "wrench",
    "contributes": {
      "composer.actions": [
        {
          "id": "purge-status",
          "label": {
            "zh": "破甲状态",
            "en": "Status"
          },
          "icon": "wrench",
          "effect": {
            "type": "open",
            "page": "panel:status"
          }
        }
      ],
      "panels": [
        {
          "id": "status",
          "title": {
            "zh": "破甲状态",
            "en": "Purge status"
          },
          "icon": "wrench",
          "placement": [
            "session.tab",
            "chat.panel",
            "features"
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "purge-alert",
          "icon": "warning",
          "panel": "status"
        }
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-go",
    "deepseek-harness",
    "prompt-injection",
    "patch",
    "android",
    "proot"
  ]
}
